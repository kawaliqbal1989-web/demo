ius-sm);\n  cursor: pointer;\n  transition: background var(--transition-fast);\n}\n.daily-mission__action-btn:hover { filter: brightness(1.1); }\n\n/* ── Weekly Plan ───────────────────────────────────────────────── */\n.weekly-plan {\n  background: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  padding: 16px 20px;\n}\n.weekly-plan__header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 10px;\n}\n.weekly-plan__title { font-weight: 700; font-size: 15px; color: var(--color-text-primary); }\n.weekly-plan__progress-badge {\n  font-size: 12px;\n  font-weight: 700;\n  color: var(--color-primary);\n  background: color-mix(in srgb, var(--color-primary) 10%, transparent);\n  padding: 2px 10px;\n  border-radius: 10px;\n}\n.weekly-plan__loading { color: var(--color-text-muted); font-size: 13px; padding: 12px 0; }\n.weekly-plan__bar-track {\n  height: 6px;\n  background: var(--color-bg-muted);\n  border-radius: 3px;\n  margin-bottom: 14px;\n  overflow: hidden;\n}\n.weekly-plan__bar-fill {\n  height: 100%;\n  background: var(--color-primary);\n  border-radius: 3px;\n  transition: width 0.6s ease;\n}\n.weekly-plan__goals { display: flex; flex-direction: column; gap: 10px; }\n.weekly-plan__goal {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 8px 12px;\n  border-radius: var(--radius-md);\n  background: var(--color-bg-muted);\n}\n.weekly-plan__goal--done { opacity: 0.65; }\n.weekly-plan__goal-icon { font-size: 20px; flex-shrink: 0; }\n.weekly-plan__goal-body { flex: 1; min-width: 0; }\n.weekly-plan__goal-title { font-weight: 600; font-size: 13px; color: var(--color-text-primary); margin-bottom: 4px; }\n.weekly-plan__goal-bar-track { height: 5px; background: var(--color-border); border-radius: 3px; overflow: hidden; }\n.weekly-plan__goal-bar-fill { height: 100%; background: var(--color-success); border-radius: 3px; transition: width 0.5s ease; }\n.weekly-plan