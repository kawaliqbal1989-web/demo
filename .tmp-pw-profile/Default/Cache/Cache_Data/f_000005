max-width: 400px) {\n  .notif-dropdown {\n    width: calc(100vw - 32px);\n    right: -8px;\n  }\n}\n\n/* ── Comprehensive Dark Mode Overrides ── */\n\nhtml[data-theme=\"dark\"] .auth-form {\n  background: #0f172a;\n  border-color: #1f2937;\n}\n\nhtml[data-theme=\"dark\"] .button.secondary {\n  background: #182338;\n  border-color: #4b607d;\n  color: #edf4ff;\n}\n\nhtml[data-theme=\"dark\"] .error {\n  color: #fca5a5;\n}\n\nhtml[data-theme=\"dark\"] .form-label {\n  color: var(--color-text-muted);\n}\n\nhtml[data-theme=\"dark\"] .ws-colsum-card__line {\n  border-top-color: #e5e7eb;\n}\n\nhtml[data-theme=\"dark\"] .ws-colsum-input {\n  background: #1e293b;\n  border-color: #475569;\n  color: #e5e7eb;\n}\n\nhtml[data-theme=\"dark\"] table {\n  color: #e5e7eb;\n}\n\nhtml[data-theme=\"dark\"] th {\n  color: #cbd5e1;\n}\n\nhtml[data-theme=\"dark\"] td {\n  color: #e5e7eb;\n}\n\nhtml[data-theme=\"dark\"] label {\n  color: #cbd5e1;\n}\n\nhtml[data-theme=\"dark\"] h1,\nhtml[data-theme=\"dark\"] h2,\nhtml[data-theme=\"dark\"] h3,\nhtml[data-theme=\"dark\"] h4,\nhtml[data-theme=\"dark\"] h5,\nhtml[data-theme=\"dark\"] h6 {\n  color: #f1f5f9;\n}\n\nhtml[data-theme=\"dark\"] p {\n  color: #e5e7eb;\n}\n\nhtml[data-theme=\"dark\"] strong {\n  color: #f1f5f9;\n}\n\nhtml[data-theme=\"dark\"] summary {\n  color: #e5e7eb;\n}\n\nhtml[data-theme=\"dark\"] details {\n  background: #0f172a;\n  border-color: #1f2937;\n}\n\nhtml[data-theme=\"dark\"] hr {\n  border-color: #1f2937;\n}\n\nhtml[data-theme=\"dark\"] select option {\n  background: #0f172a;\n  color: #e5e7eb;\n}\n\nhtml[data-theme=\"dark\"] textarea {\n  background: #0b1220;\n  border-color: #334155;\n  color: #e5e7eb;\n}\n\nhtml[data-theme=\"dark\"] input[type=\"text\"],\nhtml[data-theme=\"dark\"] input[type=\"number\"],\nhtml[data-theme=\"dark\"] input[type=\"email\"],\nhtml[data-theme=\"dark\"] input[type=\"password\"],\nhtml[data-theme=\"dark\"] input[type=\"date\"],\nhtml[data-theme=\"dark\"] input[type=\"tel\"],\nhtml[data-theme=\"dark\"] input[type=\"search\"] {\n  background: #0b1220;\n  border-color: #334155;\n  color: #e5e7eb;\n}\n\nhtml[data-theme=\"dark\"] input::placeholder,\nhtml[data-theme=\"dark\"] textarea::placeholder {\n  color: #8ea0b8;\n}\n\nhtml[data-theme=\"dark\"] .dash-table {\n  background: #0f172a;\n}\n\nhtml[data-theme=\"dark\"] .dash-table tr:hover {\n  background: #1e293b;\n}\n\nhtml[data-theme=\"dark\"] a {\n  color: #60a5fa;\n}\n\n/* ── Exam / Worksheet Dark Mode ── */\nhtml[data-theme=\"dark\"] .ws-exam-shell {\n  background: #0f172a;\n  border-color: #1f2937;\n}\n\nhtml[data-theme=\"dark\"] .ws-exam-header {\n  border-bottom-color: #1f2937;\n}\n\nhtml[data-theme=\"dark\"] .ws-colsum-card {\n  background: #1e293b;\n  border-color: #334155;\n}\n\n/* ═══════════════════════════════════════════════════════════════════\n   Design System V2 — Animations & Utility Classes\n   ═══════════════════════════════════════════════════════════════════ */\n\n/* Page enter animation — applied to .content children */\n.content > * {\n  animation: ds2-fade-up 0.28s var(--transition-smooth) both;\n}\n\n@keyframes ds2-fade-up {\n  from { opacity: 0; transform: translateY(8px); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n\n/* Skeleton shimmer */\n@keyframes ds2-shimmer {\n  0%   { background-position: 200% 0; }\n  100% { background-position: -200% 0; }\n}\n\n.ds2-skeleton {\n  background: linear-gradient(90deg,\n    var(--color-bg-muted) 25%,\n    var(--color-bg-subtle) 37%,\n    var(--color-bg-muted) 63%);\n  background-size: 400% 100%;\n  animation: ds2-shimmer 1.6s ease-in-out infinite;\n  border-radius: var(--radius-md);\n}\n\n/* Pulse animation for live indicators */\n@keyframes ds2-pulse {\n  0%, 100% { opacity: 1; }\n  50%      { opacity: 0.5; }\n}\n\n.ds2-pulse { animation: ds2-pulse 2s ease-in-out infinite; }\n\n/* Card hover lift */\n.ds2-card-interactive {\n  cursor: pointer;\n  transition: transform var(--transition-base), box-shadow var(--transition-base);\n}\n\n.ds2-card-interactive:hover {\n  transform: translateY(-2px);\n  box-shadow: var(--shadow-md);\n}\n\n/* MetricCard V2 */\n.metric-card-v2 {\n  display: grid;\n  gap: 8px;\n  padding: 18px;\n  position: relative;\n  overflow: hidden;\n}\n\n.metric-card-v2::before {\n  content: \"\";\n  position: absolute;\n  top: 0; left: 0; right: 0;\n  height: 3px;\n  background: var(--metric-accent, var(--color-primary));\n  border-radius: var(--radius-lg) var(--radius-lg) 0 0;\n}\n\n.metric-card-v2__icon {\n  width: 40px;\n  height: 40px;\n  border-radius: var(--radius-md);\n  display: grid;\n  place-items: center;\n  font-size: 18px;\n  background: var(--color-primary-bg);\n  color: var(--color-primary);\n}\n\n.metric-card-v2__label {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--color-text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n}\n\n.metric-card-v2__value {\n  font-size: 28px;\n  font-weight: 800;\n  letter-spacing: -0.02em;\n  line-height: 1;\n}\n\n.metric-card-v2__trend {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 12px;\n  font-weight: 600;\n  padding: 2px 8px;\n  border-radius: var(--radius-full);\n}\n\n.metric-card-v2__trend--up {\n  background: var(--color-bg-success-light);\n  color: var(--color-text-success);\n}\n\n.metric-card-v2__trend--down {\n  background: var(--color-bg-danger-light);\n  color: var(--color-text-danger);\n}\n\n/* Command Palette */\n.cmd-palette-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgba(0,0,0,0.45);\n  backdrop-filter: blur(4px);\n  z-index: 200;\n  display: grid;\n  place-items: start center;\n  padding-top: min(20vh, 160px);\n  animation: ds2-fade-in 0.15s ease both;\n}\n\n@keyframes ds2-fade-in {\n  from { opacity: 0; }\n  to   { opacity: 1; }\n}\n\n.cmd-palette {\n  width: 100%;\n  max-width: 560px;\n  background: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-xl);\n  box-shadow: var(--shadow-lg);\n  overflow: hidden;\n  animation: ds2-scale-in 0.18s cubic-bezier(0.16,1,0.3,1) both;\n}\n\n@keyframes ds2-scale-in {\n  from { opacity: 0; transform: scale(0.96) translateY(-8px); }\n  to   { opacity: 1; transform: scale(1) translateY(0); }\n}\n\n.cmd-palette__input-wrap {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 14px 18px;\n  border-bottom: 1px solid var(--color-border-divider);\n}\n\n.cmd-palette__input-wrap svg {\n  flex-shrink: 0;\n  color: var(--color-text-muted);\n}\n\n.cmd-palette__input {\n  flex: 1;\n  border: none;\n  background: transparent;\n  font-size: 16px;\n  color: var(--color-text-primary);\n  outline: none;\n}\n\n.cmd-palette__input::placeholder {\n  color: var(--color-text-faint);\n}\n\n.cmd-palette__results {\n  max-height: 340px;\n  overflow-y: auto;\n  padding: 6px;\n}\n\n.cmd-palette__group-label {\n  padding: 8px 12px 4px;\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: var(--color-text-faint);\n}\n\n.cmd-palette__item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 12px;\n  border-radius: var(--radius-md);\n  cursor: pointer;\n  font-size: 14px;\n  transition: background var(--transition-fast);\n}\n\n.cmd-palette__item:hover,\n.cmd-palette__item--active {\n  background: var(--color-primary-bg);\n  color: var(--color-primary);\n}\n\n.cmd-palette__item-icon {\n  font-size: 16px;\n  width: 24px;\n  text-align: center;\n  flex-shrink: 0;\n}\n\n.cmd-palette__empty {\n  padding: 24px 18px;\n  text-align: center;\n  color: var(--color-text-muted);\n  font-size: 14px;\n}\n\n.cmd-palette__footer {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px 18px;\n  border-top: 1px solid var(--color-border-divider);\n  font-size: 12px;\n  color: var(--color-text-faint);\n}\n\n.cmd-palette__kbd {\n  display: inline-flex;\n  align-items: center;\n  padding: 2px 6px;\n  background: var(--color-bg-muted);\n  border: 1px solid var(--color-border);\n  border-radius: 4px;\n  font-size: 11px;\n  font-weight: 600;\n  font-family: inherit;\n  line-height: 1.2;\n}\n\n/* SearchableDropdown */\n.searchable-dropdown {\n  position: relative;\n}\n\n.searchable-dropdown__menu {\n  position: absolute;\n  top: calc(100% + 4px);\n  left: 0;\n  right: 0;\n  max-height: 220px;\n  overflow-y: auto;\n  background: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  box-shadow: var(--shadow-md);\n  z-index: 40;\n  animation: ds2-fade-up 0.15s ease both;\n}\n\n.searchable-dropdown__option {\n  padding: 9px 12px;\n  cursor: pointer;\n  font-size: 14px;\n  transition: background var(--transition-fast);\n}\n\n.searchable-dropdown__option:hover,\n.searchable-dropdown__option--active {\n  background: var(--color-primary-bg);\n  color: var(--color-primary);\n}\n\n.searchable-dropdown__option--selected {\n  font-weight: 600;\n}\n\n.searchable-dropdown__empty {\n  padding: 12px;\n  color: var(--color-text-muted);\n  font-size: 13px;\n  text-align: center;\n}\n\n/* Empty state illustration */\n.empty-state {\n  display: grid;\n  place-items: center;\n  gap: 14px;\n  padding: 48px 20px;\n  text-align: center;\n}\n\n.empty-state__icon {\n  width: 80px;\n  height: 80px;\n  border-radius: var(--radius-xl);\n  background: var(--color-bg-muted);\n  display: grid;\n  place-items: center;\n  font-size: 32px;\n  color: var(--color-text-faint);\n}\n\n.empty-state__title {\n  font-size: 16px;\n  font-weight: 700;\n  color: var(--color-text-primary);\n  margin: 0;\n}\n\n.empty-state__desc {\n  font-size: 14px;\n  color: var(--color-text-muted);\n  max-width: 360px;\n  margin: 0;\n}\n\n/* Skeleton loader */\n.skeleton-card {\n  display: grid;\n  gap: 12px;\n  padding: 18px;\n}\n\n.skeleton-line {\n  height: 12px;\n  border-radius: var(--radius-sm);\n}\n\n.skeleton-line--title {\n  height: 20px;\n  width: 60%;\n}\n\n.skeleton-line--short {\n  width: 40%;\n}\n\n.skeleton-line--full {\n  width: 100%;\n}\n\n/* Step Wizard */\n.step-wizard__header {\n  display: flex;\n  align-items: center;\n  gap: 0;\n  padding: 0 0 20px;\n}\n\n.step-wizard__step {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex: 1;\n  position: relative;\n}\n\n.step-wizard__step::after {\n  content: \"\";\n  flex: 1;\n  height: 2px;\n  background: var(--color-border);\n  margin: 0 8px;\n  transition: background var(--transition-base);\n}\n\n.step-wizard__step:last-child::after { display: none; }\n\n.step-wizard__step--complete::after {\n  background: var(--color-success);\n}\n\n.step-wizard__dot {\n  width: 32px;\n  height: 32px;\n  border-radius: var(--radius-full);\n  border: 2px solid var(--color-border-strong);\n  display: grid;\n  place-items: center;\n  font-size: 13px;\n  font-weight: 700;\n  color: var(--color-text-muted);\n  background: var(--color-bg-card);\n  transition: all var(--transition-base);\n  flex-shrink: 0;\n}\n\n.step-wizard__step--active .step-wizard__dot {\n  border-color: var(--color-primary);\n  color: #fff;\n  background: var(--color-primary);\n  box-shadow: var(--shadow-glow-primary);\n}\n\n.step-wizard__step--complete .step-wizard__dot {\n  border-color: var(--color-success);\n  color: #fff;\n  background: var(--color-success);\n}\n\n.step-wizard__label {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--color-text-muted);\n  white-space: nowrap;\n  display: none;\n}\n\n@media (min-width: 720px) {\n  .step-wizard__label { display: block; }\n}\n\n.step-wizard__step--active .step-wizard__label {\n  color: var(--color-primary);\n}\n\n.step-wizard__step--complete .step-wizard__label {\n  color: var(--color-success);\n}\n\n/* Badge V2 */\n.badge-v2 {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 3px 10px;\n  border-radius: var(--radius-full);\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n  transition: transform var(--transition-fast);\n}\n\n/* Section header */\n.section-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 12px;\n}\n\n.section-header__title {\n  font-size: 16px;\n  font-weight: 700;\n  margin: 0;\n}\n\n.section-header__action {\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--color-primary);\n  cursor: pointer;\n  background: none;\n  border: none;\n  padding: 4px 8px;\n  border-radius: var(--radius-sm);\n  transition: background var(--transition-fast);\n}\n\n.section-header__action:hover {\n  background: var(--color-primary-bg);\n}\n\n/* Topbar search trigger */\n.topbar-search-trigger {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 7px 14px;\n  background: var(--color-bg-muted);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  color: var(--color-text-faint);\n  font-size: 13px;\n  cursor: pointer;\n  transition: border-color var(--transition-fast), background var(--transition-fast);\n  min-width: 200px;\n}\n\n.topbar-search-trigger:hover {\n  border-color: var(--color-border-strong);\n  background: var(--color-bg-subtle);\n}\n\n.topbar-search-trigger .cmd-palette__kbd {\n  margin-left: auto;\n}\n\n/* Theme toggle button V2 */\n.theme-toggle {\n  display: grid;\n  place-items: center;\n  width: 36px;\n  height: 36px;\n  border-radius: var(--radius-md);\n  border: 1px solid var(--color-border);\n  background: transparent;\n  color: var(--color-text-secondary);\n  cursor: pointer;\n  transition: background var(--transition-fast), color var(--transition-fast);\n}\n\n.theme-toggle:hover {\n  background: var(--color-bg-muted);\n  color: var(--color-text-primary);\n}\n\n/* ═══════════════════════════════════════════════════════════════════\n   Phase 5 — Student Coach Components\n   ═══════════════════════════════════════════════════════════════════ */\n\n/* ── Streak Bar ────────────────────────────────────────────────── */\n.streak-bar {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 14px 20px;\n  background: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  flex-wrap: wrap;\n}\n.streak-bar__item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.streak-bar__icon { font-size: 28px; }\n.streak-bar__info { display: flex; flex-direction: column; }\n.streak-bar__value { font-size: 22px; font-weight: 800; color: var(--color-text-primary); line-height: 1.1; }\n.streak-bar__label { font-size: 12px; color: var(--color-text-muted); }\n.streak-bar__best { font-size: 11px; color: var(--color-text-muted); background: var(--color-bg-muted); padding: 2px 8px; border-radius: 10px; }\n.streak-bar__divider { width: 1px; height: 36px; background: var(--color-border); }\n\n/* ── Daily Mission ─────────────────────────────────────────────── */\n.daily-mission {\n  background: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  padding: 16px 20px;\n}\n.daily-mission__header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 12px;\n}\n.daily-mission__title { font-weight: 700; font-size: 15px; color: var(--color-text-primary); }\n.daily-mission__progress {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--color-primary);\n  background: color-mix(in srgb, var(--color-primary) 10%, transparent);\n  padding: 2px 10px;\n  border-radius: 10px;\n}\n.daily-mission__loading { color: var(--color-text-muted); font-size: 13px; padding: 12px 0; }\n.daily-mission__list { display: flex; flex-direction: column; gap: 8px; }\n.daily-mission__card {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px 14px;\n  border-radius: var(--radius-md);\n  background: var(--color-bg-muted);\n  transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n}\n.daily-mission__card:hover { transform: translateY(-1px); box-shadow: var(--shadow-sm); }\n.daily-mission__card--done { opacity: 0.65; }\n\n/* ═══════════════════════════════════════════════════════════════════\n   BP Dashboard\n   ═══════════════════════════════════════════════════════════════════ */\n\n.bpdash-page {\n  display: grid;\n  gap: 16px;\n}\n\n.bpdash-page__meta {\n  color: var(--color-text-muted);\n  font-size: 12px;\n}\n\n.bpdash-banner {\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  font-size: 13px;\n  line-height: 1.5;\n  padding: 12px 14px;\n}\n\n.bpdash-banner--warning {\n  background: color-mix(in srgb, var(--color-warning) 12%, transparent);\n  border-color: color-mix(in srgb, var(--color-warning) 35%, var(--color-border));\n  color: var(--color-text-primary);\n}\n\n.bpdash-banner--info {\n  background: color-mix(in srgb, var(--color-primary) 9%, transparent);\n  border-color: color-mix(in srgb, var(--color-primary) 28%, var(--color-border));\n  color: var(--color-text-primary);\n}\n\n.bpdash-filters {\n  display: grid;\n  gap: 14px;\n}\n\n.bpdash-filters__header {\n  align-items: flex-start;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 16px;\n  justify-content: space-between;\n}\n\n.bpdash-filters__title {\n  font-size: 18px;\n  margin: 0;\n}\n\n.bpdash-filters__subtitle {\n  color: var(--color-text-muted);\n  font-size: 13px;\n  line-height: 1.5;\n  margin: 6px 0 0;\n  max-width: 760px;\n}\n\n.bpdash-filters__actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n}\n\n.bpdash-filters__grid {\n  display: grid;\n  gap: 12px;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n\n.bpdash-filters__field {\n  display: grid;\n  gap: 6px;\n}\n\n.bpdash-filters__label {\n  color: var(--color-text-muted);\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n\n.bpdash-chart-grid {\n  display: grid;\n  gap: 16px;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.bpdash-widget {\n  display: grid;\n  gap: 14px;\n}\n\n.bpdash-widget--flat {\n  padding-bottom: 4px;\n}\n\n.bpdash-widget__header {\n  align-items: flex-start;\n  display: flex;\n  gap: 16px;\n  justify-content: space-between;\n}\n\n.bpdash-widget__title-row {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n}\n\n.bpdash-widget__title {\n  font-size: 18px;\n  margin: 0;\n}\n\n.bpdash-widget__description {\n  color: var(--color-text-muted);\n  font-size: 13px;\n  line-height: 1.55;\n  margin: 6px 0 0;\n}\n\n.bpdash-widget__meta {\n  color: var(--color-text-muted);\n  font-size: 12px;\n  margin-top: 6px;\n}\n\n.bpdash-widget__badge {\n  align-items: center;\n  background: color-mix(in srgb, var(--color-primary) 10%, transparent);\n  border-radius: 999px;\n  color: var(--color-primary);\n  display: inline-flex;\n  font-size: 12px;\n  font-weight: 700;\n  padding: 4px 10px;\n}\n\n.bpdash-widget__inline-error {\n  align-items: center;\n  background: color-mix(in srgb, var(--color-error) 8%, transparent);\n  border: 1px solid color-mix(in srgb, var(--color-error) 28%, var(--color-border));\n  border-radius: var(--radius-md);\n  color: var(--color-text-primary);\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  justify-content: space-between;\n  padding: 10px 12px;\n}\n\n.bpdash-kpi-grid {\n  display: grid;\n  gap: 12px;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n\n.bpdash-summary-row {\n  display: grid;\n  gap: 12px;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.bpdash-summary-card {\n  background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 8%, transparent), transparent);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  display: grid;\n  gap: 4px;\n  padding: 12px 14px;\n}\n\n.bpdash-summary-card span {\n  color: var(--color-text-muted);\n  font-size: 12px;\n}\n\n.bpdash-summary-card strong {\n  font-size: 18px;\n}\n\n.bpdash-chart-surface {\n  min-height: 280px;\n}\n\n.bpdash-inline-note {\n  background: color-mix(in srgb, var(--color-primary) 7%, transparent);\n  border-radius: var(--