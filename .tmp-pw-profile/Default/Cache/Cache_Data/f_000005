x(in srgb, var(--color-warning) 30%, transparent);\n  border-radius: var(--radius-md);\n  padding: 8px 14px;\n  margin-bottom: 12px;\n}\n.milestone-card__new-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--color-warning);\n}\n.milestone-card__new-icon { font-size: 20px; }\n.milestone-card__grid {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-bottom: 12px;\n}\n.milestone-card__badge {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n  padding: 10px 12px;\n  border-radius: var(--radius-md);\n  background: var(--color-bg-muted);\n  min-width: 72px;\n  transition: transform var(--transition-fast);\n}\n.milestone-card__badge:hover { transform: scale(1.05); }\n.milestone-card__badge-icon { font-size: 26px; }\n.milestone-card__badge-title { font-size: 10px; font-weight: 600; color: var(--color-text-secondary); text-align: center; }\n.milestone-card__next { border-top: 1px solid var(--color-border); padding-top: 12px; }\n.milestone-card__hint {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  padding: 6px 0;\n  font-size: 13px;\n}\n.milestone-card__hint-body { flex: 1; }\n.milestone-card__hint-title { font-weight: 600; color: var(--color-text-primary); font-size: 13px; }\n.milestone-card__hint-text { font-size: 12px; color: var(--color-text-muted); margin: 2px 0 4px; }\n.milestone-card__hint-bar-track { height: 4px; background: var(--color-bg-muted); border-radius: 2px; overflow: hidden; }\n.milestone-card__hint-bar-fill { height: 100%; background: var(--color-primary); border-radius: 2px; transition: width 0.5s ease; }\n\n/* ── Performance Explainer ─────────────────────────────────────── */\n.perf-explainer {\n  background: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  padding: 16px 20px;\n}\n.perf-explainer__title { font-weight: 700; font-size: 15px; color: var(--color-text-primary);