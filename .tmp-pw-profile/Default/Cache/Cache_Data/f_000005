\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  position: relative;\n  padding: 0;\n  padding-bottom: 8px;\n  min-width: 64px;\n}\n\n/* Vertical rod wire running through center */\n.virtual-abacus__rod::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  bottom: 44px;\n  left: 50%;\n  width: 3px;\n  margin-left: -1.5px;\n  background: linear-gradient(to right, #a1887f, #d7ccc8, #a1887f);\n  border-radius: 1.5px;\n  z-index: 0;\n  box-shadow: 0 0 3px rgba(0,0,0,0.2);\n}\n\n/* Units rod highlight */\n.virtual-abacus__rod.is-units {\n  background: rgba(255,255,255,0.07);\n  border-radius: 6px;\n}\n\n/* Decimal separator after units rod */\n.virtual-abacus__rod.is-units::after {\n  content: \"\";\n  position: absolute;\n  top: 6px;\n  bottom: 44px;\n  right: -1px;\n  width: 2px;\n  background: #ffcc80;\n  border-radius: 999px;\n  z-index: 3;\n}\n\n/* Upper deck — space for 1 heaven bead + travel */\n.virtual-abacus__upper-deck {\n  height: 74px;\n  display: flex;\n  align-items: flex-start;\n  justify-content: center;\n  position: relative;\n  z-index: 1;\n  padding-top: 4px;\n}\n\n/* Lower deck — space for 4 earth beads + travel gap */\n.virtual-abacus__lower-deck {\n  height: 214px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 6px;\n  position: relative;\n  z-index: 1;\n  padding-top: 4px;\n}\n\n/* Reckoning bar (beam) */\n.virtual-abacus__bar {\n  width: calc(100% + 8px);\n  margin: 0 -4px;\n  height: 8px;\n  background: linear-gradient(to bottom, #5d4037, #3e2723, #4e342e);\n  border-radius: 1px;\n  z-index: 2;\n  box-shadow: 0 2px 6px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.1);\n  flex-shrink: 0;\n  position: relative;\n}\n\n/* Bead base */\n.virtual-abacus__bead {\n  width: 64px;\n  height: 32px;\n  border-radius: 999px;\n  border: none;\n  cursor: pointer;\n  position: relative;\n  z-index: 1;\n  transition: transform 0.18s cubic-bezier(0.4, 0, 0.2, 1);\n  flex-shrink: 0;\n  outline-of