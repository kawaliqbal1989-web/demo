  enrollmentEndAt       DateTime?
  practiceStartAt       DateTime?
  startsAt              DateTime?
  endsAt                DateTime?
  durationMinutes       Int?
  attemptLimit          Int?
  slotCode              String?
  slotStartAt           DateTime?
  slotEndAt             DateTime?
  resultStatusMirror    String?
  resultPublishedAtMirror DateTime?
  legacyWorkflowStage   String?
