  updatedAt             DateTime                @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assessment           Assessment           @relation("AssessmentVersions", fields: [assessmentId], references: [id], onDelete: Cascade)
  parentVersion        AssessmentVersion?   @relation("AssessmentVersionParent", fields: [parentVersionId], references: [id], onDelete: SetNull)
