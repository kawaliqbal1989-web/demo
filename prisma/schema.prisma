  activeForAssessments Assessment[]         @relation("AssessmentActiveVersion")

  @@unique([tenantId, assessmentId, versionNumber], map: "asv_t_ass_ver_uq")
  @@index([tenantId, sourceEntityId], map: "asv_t_src_i")
  @@index([tenantId, versionStatus], map: "asv_t_vst_i")
  @@index([tenantId, startsAt], map: "asv_t_sta_i")
  @@index([tenantId, endsAt], map: "asv_t_end_i")
  @@index([tenantId, resultStatusMirror], map: "asv_t_rsm_i")
  @@index([tenantId, assessmentId, versionStatus], map: "asv_t_ass_vst_i")
  @@index([tenantId, slotCode, slotStartAt], map: "asv_t_slot_i")
  @@map("assessmentversion")
}

