  bestPracticeStreak     Int      @default(0)
  currentAttendanceStreak Int     @default(0)
  bestAttendanceStreak   Int      @default(0)
  completedWorksheetCount Int     @default(0)
  pendingWorksheetCount  Int      @default(0)
