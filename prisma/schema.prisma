// ─── Phase 4: Intelligence Platform ───────────────────────────

enum InsightCategory {
  RISK
  PERFORMANCE
  ATTENDANCE
  FINANCIAL
  PROMOTION
  ENGAGEMENT
  OPERATIONAL
  COMPLIANCE
}

enum InsightSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

model Insight {
  id           String          @id @default(cuid())
  tenantId     String
  targetRole   Role
  targetUserId String
  category     InsightCategory
  severity     InsightSeverity
  title        String
  message      String          @db.Text
  actionLabel  String?
  actionUrl    String?
  entityType   String?
  entityId     String?
  metadata     Json?
  isDismissed  Boolean         @default(false)
  isActioned   Boolean         @default(false)
  expiresAt    DateTime?
  createdAt    DateTime        @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  targetUser AuthUser @relation("InsightTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, targetUserId, isDismissed, createdAt])
  @@index([tenantId, targetRole, category, createdAt])
  @@index([tenantId, severity, createdAt])
  @@index([expiresAt])
   @@map("insight")
}

