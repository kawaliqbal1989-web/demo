  superadmins                      Superadmin[]
  hierarchyNodes                   HierarchyNode[]
  levels                           Level[]
  courses                          Course[]
  studentAssignedCourses           StudentAssignedCourse[]
  courseLevels                     CourseLevel[]
  students                         Student[]
  teacherNotes                     TeacherNote[]
  worksheets                       Worksheet[]
  materials                        Material[]
  submissions                      WorksheetSubmission[]
  worksheetAssignments             WorksheetAssignment[]
  competitions                     Competition[]
  competitionBusinessPartners      CompetitionBusinessPartner[]
  competitionStageTransitions      CompetitionStageTransition[]
  competitionLinks                 CompetitionWorksheet[]
  enrollments                      CompetitionEnrollment[]
  refreshTokens                    RefreshToken[]
  auditLogs                        AuditLog[]
  businessPartners                 BusinessPartner[]
  businessPartnerFranchises        BusinessPartnerFranchise[]
  businessPartnerCenterScopes      BusinessPartnerCenterScope[]
  analyticsDailySnapshots          AnalyticsDailySnapshot[]
  franchiseAnalyticsSnapshots      FranchiseAnalyticsSnapshot[]
  centerAnalyticsSnapshots         CenterAnalyticsSnapshot[]
  margins                          Margin[]
  settlements                      Settlement[]
  levelRules                       LevelRule[]
  studentLevelCompletions          StudentLevelCompletion[]
  studentLevelProgressionHistories StudentLevelProgressionHistory[]
  worksheetQuestions               WorksheetQuestion[]
  worksheetTemplates               WorksheetTemplate[]
  questionBankEntries              QuestionBank[]
  userSequences                    UserSequence[]
  abuseFlags                       AbuseFlag[]
  notifications                    Notification[]
  notificationPreferences          NotificationPreference[]
  operationalNotifications         OperationalNotification[]
  operationalNotificationTargets   OperationalNotificationTarget[]
  operationalNotificationRuleStates OperationalNotificationRuleState[]
  franchiseOperationalWorkflows    FranchiseOperationalWorkflow[]
  franchiseOperationalWorkflowHistories FranchiseOperationalWorkflowHistory[]
  franchiseOperationalWorkflowTasks FranchiseOperationalWorkflowTask[]
  franchiseOperationalEscalations  FranchiseOperationalEscalation[]
  centerOperationalWorkflows       CenterOperationalWorkflow[]
  centerOperationalWorkflowHistories CenterOperationalWorkflowHistory[]
  centerOperationalWorkflowTasks   CenterOperationalWorkflowTask[]
  teacherOperationalWorkflows      TeacherOperationalWorkflow[]
  teacherOperationalWorkflowHistories TeacherOperationalWorkflowHistory[]
  teacherOperationalWorkflowTasks  TeacherOperationalWorkflowTask[]
  financialTransactions            FinancialTransaction[]
  receiptSequences                 ReceiptSequence[]
  paymentReceipts                  PaymentReceipt[]
  paymentTransactions              PaymentTransaction[]
  receiptAllocations               ReceiptAllocation[]
  refundTransactions               RefundTransaction[]
  receiptAuditLogs                 ReceiptAuditLog[]
  settlementWorkflowHistories      SettlementWorkflowHistory[]
  settlementWorkflowTasks          SettlementWorkflowTask[]
  settlementEscalations            SettlementEscalation[]
  settlementSupportingRecords      SettlementSupportingRecord[]
  feeInstallments                  StudentFeeInstallment[]
  feeMonthAdjustments              StudentFeeMonthAdjustment[]
  certificates                     Certificate[]
  franchiseProfiles                FranchiseProfile[]
  franchiseAddresses               FranchiseAddress[]
  centerProfiles                   CenterProfile[]
  centerAddresses                  CenterAddress[]
  teacherProfiles                  TeacherProfile[]
  batches                          Batch[]
  batchTeacherAssignments          BatchTeacherAssignment[]
  batchEnrollments                 Enrollment[]
  attendanceSessions               AttendanceSession[]
  attendanceEntries                AttendanceEntry[]
  attendanceCorrectionRequests     AttendanceCorrectionRequest[]
  mockTests                        MockTest[]
  mockTestResults                  MockTestResult[]
  batchScheduleSlots               BatchScheduleSlot[]

  examCycles                             ExamCycle[]
  examPracticePlans                      ExamPracticePlan[]
  examTextbookData                       ExamTextbookData[]
  examEnrollmentLists                    ExamEnrollmentList[]
  examEnrollmentEntries                  ExamEnrollmentEntry[]
  examEnrollmentListItems                ExamEnrollmentListItem[]
  examEnrollmentLevelWorksheetSelections ExamEnrollmentLevelWorksheetSelection[]
  examLevelAssessmentConfigs             ExamLevelAssessmentConfig[]
  examGeneratedQuestionSets              ExamGeneratedQuestionSet[]
  examResultPublicationAudits            ExamResultPublicationAudit[]
  examLateEnrollmentRequests             ExamLateEnrollmentRequest[]
  examLateEnrollmentStudents             ExamLateEnrollmentStudent[]
  aiPlaygroundLogs                       AiPlaygroundLog[]
  aiCustomTools                          AiCustomTool[]
  worksheetReassignmentRequests          WorksheetReassignmentRequest[]
  businessPartnerPracticeEntitlements    BusinessPartnerPracticeEntitlement[]
  centerPracticeAllocations              CenterPracticeAllocation[]
  studentPracticeAssignments             StudentPracticeAssignment[]
  certificateTemplates                   CertificateTemplate[]
  insights                               Insight[]
  studentMilestones                      StudentMilestone[]
  parentStudentLinks                     ParentStudentLink[]
  studentEngagementSnapshots             StudentEngagementSnapshot[]
  reportExportJobs                       ReportExportJob[]                  @relation("ReportExportJobsByTenant")
  reportExportArtifacts                  ReportExportArtifact[]             @relation("ReportExportArtifactsByTenant")
