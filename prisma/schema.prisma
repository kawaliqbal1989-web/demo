model Certificate {
  id                String            @id @default(cuid())
  tenantId          String
  certificateNumber String
  status            CertificateStatus @default(ISSUED)
  studentId         String
  levelId           String
  courseId          String?
  issuedByUserId    String
  issuedAt          DateTime          @default(now())
  revokedAt         DateTime?
  revokedByUserId   String?
  reason            String?
  courseSnapshot    Json?
  levelSnapshot     Json?
  brandingSnapshot  Json?
  metadata          Json?
  verificationToken String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level     Level     @relation(fields: [levelId], references: [id], onDelete: Restrict)
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  issuedBy  AuthUser  @relation("CertificateIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  revokedBy AuthUser? @relation("CertificateRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, certificateNumber])
  @@index([tenantId, status, issuedAt])
  @@index([tenantId, studentId, issuedAt])
  @@index([tenantId, levelId, issuedAt])
  @@index([tenantId, courseId, issuedAt])
   @@map("certificate")
}

model AiPlaygroundLog {
