model IdempotencyKey {
  id               String   @id @default(cuid())
  tenantId         String
  key              String
  method           String
  path             String
  requestHash      String?
  responseEntityId String?
  responseStatus   Int?
  responseBody     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, key, method, path])
  @@index([tenantId, key])
    @@map("tdempotencykey")
}

model AuthUser {
  id                             String                           @id @default(cuid())
  username                       String?
  email                          String
  passwordHash                   String
  role                           Role
  isActive                       Boolean                          @default(true)
  failedAttempts                 Int                              @default(0)
  lockUntil                      DateTime?
  mustChangePassword             Boolean                          @default(false)
  tenantId                       String
  parentUserId                   String?
  hierarchyNodeId                String?
  studentId                      String?                          @unique
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
  tenant                         Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parentUser                     AuthUser?                        @relation("AuthUserHierarchy", fields: [parentUserId], references: [id], onDelete: SetNull)
  childUsers                     AuthUser[]                       @relation("AuthUserHierarchy")
  hierarchyNode                  HierarchyNode?                   @relation(fields: [hierarchyNodeId], references: [id], onDelete: SetNull)
  student                        Student?                         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  refreshTokens                  RefreshToken[]
  auditLogs                      AuditLog[]
  worksheetsCreated              Worksheet[]
  competitionsCreated            Competition[]
  competitionsRejected           Competition[]                    @relation("CompetitionRejectedBy")
  competitionStageTransitions    CompetitionStageTransition[]
  createdPartners                BusinessPartner[]                @relation("PartnerCreatedBy")
  updatedPartnerBranding         BusinessPartner[]                @relation("PartnerBrandingUpdatedBy")
  resolvedAbuseFlags             AbuseFlag[]                      @relation("AbuseResolvedBy")
  notificationsReceived          Notification[]                   @relation("NotificationRecipient")
  notificationPreferences        NotificationPreference[]         @relation("NotificationPreferences")
  operationalNotificationTargets OperationalNotificationTarget[]
  franchiseOperationalWorkflowHistoryActions FranchiseOperationalWorkflowHistory[] @relation("FranchiseOperationalWorkflowHistoryActor")
  franchiseOperationalWorkflowTasks FranchiseOperationalWorkflowTask[] @relation("FranchiseOperationalWorkflowTaskTargetUser")
  centerOperationalWorkflowHistoryActions CenterOperationalWorkflowHistory[] @relation("CenterOperationalWorkflowHistoryActor")
  centerOperationalWorkflowTasks CenterOperationalWorkflowTask[] @relation("CenterOperationalWorkflowTaskTargetUser")
  teacherOperationalWorkflowHistoryActions TeacherOperationalWorkflowHistory[] @relation("TeacherOperationalWorkflowHistoryActor")
  teacherOperationalWorkflowTasks TeacherOperationalWorkflowTask[] @relation("TeacherOperationalWorkflowTaskTargetUser")
  settlementsReviewed            Settlement[]                     @relation("SettlementReviewedBy")
  settlementsApproved            Settlement[]                     @relation("SettlementApprovedBy")
  settlementsRejected            Settlement[]                     @relation("SettlementRejectedBy")
  settlementsPaid                Settlement[]                     @relation("SettlementPaidBy")
  settlementWorkflowHistoryActions SettlementWorkflowHistory[]    @relation("SettlementWorkflowHistoryActor")
  settlementWorkflowTasks        SettlementWorkflowTask[]         @relation("SettlementWorkflowTaskTargetUser")
  settlementSupportingRecords    SettlementSupportingRecord[]     @relation("SettlementSupportingRecordUploadedBy")
  createdFeeMonthAdjustments     StudentFeeMonthAdjustment[]      @relation("StudentFeeMonthAdjustmentCreatedBy")
  superadminProfile              Superadmin?
  promotedProgressions           StudentLevelProgressionHistory[]
  financialTransactions          FinancialTransaction[]
  paymentReceiptsCollected       PaymentReceipt[]                 @relation("PaymentReceiptCollectedBy")
  paymentReceiptsCancelled       PaymentReceipt[]                 @relation("PaymentReceiptCancelledBy")
  paymentTransactionsCreated     PaymentTransaction[]             @relation("PaymentTransactionCreatedBy")
  refundTransactionsProcessed    RefundTransaction[]              @relation("RefundTransactionProcessedBy")
  receiptAuditLogs               ReceiptAuditLog[]                @relation("ReceiptAuditActor")
  certificatesIssued             Certificate[]                    @relation("CertificateIssuedBy")
  certificatesRevoked            Certificate[]                    @relation("CertificateRevokedBy")
  approvedCenterBranding         CenterProfile[]                  @relation("CenterBrandingApprovedBy")
  franchiseProfile               FranchiseProfile?
  centerProfile                  CenterProfile?
  teacherProfile                 TeacherProfile?
  parentStudentLinks             ParentStudentLink[]                 @relation("ParentStudentLinkParentUser")
  primaryBatches                 Batch[]                          @relation("BatchPrimaryTeacher")
  archivedBatches                Batch[]                          @relation("BatchArchivedBy")
  deletedBatches                 Batch[]                          @relation("BatchDeletedBy")
  batchTeacherAssignments        BatchTeacherAssignment[]
  assignedEnrollments            Enrollment[]                     @relation("EnrollmentAssignedTeacher")
  attendanceSessionsCreated      AttendanceSession[]              @relation("AttendanceSessionCreatedBy")
  attendanceEntriesMarked        AttendanceEntry[]                @relation("AttendanceEntryMarkedBy")
  attendanceCorrectionsRequested AttendanceCorrectionRequest[]    @relation("AttendanceCorrectionRequestedBy")
  attendanceCorrectionsReviewed  AttendanceCorrectionRequest[]    @relation("AttendanceCorrectionReviewedBy")
  mockTestsCreated               MockTest[]                       @relation("MockTestCreatedBy")
  mockTestResultsRecorded        MockTestResult[]                 @relation("MockTestResultRecordedBy")
  teacherNotes                   TeacherNote[]

  studentsAsCurrentTeacher Student[] @relation("StudentCurrentTeacher")

  worksheetAssignmentsCreated WorksheetAssignment[] @relation("WorksheetAssignmentCreatedBy")

  examCyclesCreated            ExamCycle[]           @relation("ExamCycleCreatedBy")
  examCyclesPublished          ExamCycle[]           @relation("ExamCycleResultPublishedBy")
  examEnrollmentListsCreated   ExamEnrollmentList[]  @relation("ExamEnrollmentListCreatedBy")
  examEnrollmentListsRejected  ExamEnrollmentList[]  @relation("ExamEnrollmentListRejectedBy")
  examEnrollmentEntriesCreated ExamEnrollmentEntry[] @relation("ExamEnrollmentEntryCreatedBy")

  examEnrollmentListsAsTeacher         ExamEnrollmentList[]  @relation("ExamEnrollmentListTeacherUser")
  examEnrollmentEntriesAsSourceTeacher ExamEnrollmentEntry[] @relation("ExamEnrollmentEntrySourceTeacher")

  createdExamPracticePlans ExamPracticePlan[] @relation("ExamPracticePlanCreatedBy")
  createdExamTextbookData  ExamTextbookData[] @relation("ExamTextbookDataCreatedBy")

  examEnrollmentLevelWorksheetSelectionsCreated ExamEnrollmentLevelWorksheetSelection[] @relation("ExamEnrollmentLevelWorksheetSelectionCreatedBy")
  examLevelAssessmentConfigsCreated             ExamLevelAssessmentConfig[]             @relation("ExamLevelAssessmentConfigCreatedBy")
  examResultPublicationAudits                   ExamResultPublicationAudit[]            @relation("ExamResultPublicationAuditActor")
  examLateEnrollmentRequestsSubmitted           ExamLateEnrollmentRequest[]             @relation("ExamLateEnrollmentRequestSubmittedBy")
  examLateEnrollmentRequestsReviewed            ExamLateEnrollmentRequest[]             @relation("ExamLateEnrollmentRequestReviewedBy")
  examLateEnrollmentStudentsApproved            ExamLateEnrollmentStudent[]             @relation("ExamLateEnrollmentStudentApprovedBy")

  worksheetReassignmentRequestsCreated  WorksheetReassignmentRequest[] @relation("WorksheetReassignRequestedBy")
  worksheetReassignmentRequestsReviewed WorksheetReassignmentRequest[] @relation("WorksheetReassignReviewedBy")

  practiceEntitlementsCreated   BusinessPartnerPracticeEntitlement[] @relation("PracticeEntitlementCreatedBy")
  practiceAllocationsAllocated  CenterPracticeAllocation[]           @relation("PracticeAllocationAllocatedBy")
  practiceAssignmentsAssigned   StudentPracticeAssignment[]          @relation("PracticeAssignmentAssignedBy")
  practiceAssignmentsUnassigned StudentPracticeAssignment[]          @relation("PracticeAssignmentUnassignedBy")

  insightsReceived Insight[] @relation("InsightTarget")
