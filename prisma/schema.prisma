  studentId              String
  hierarchyNodeId        String?
  snapshotDate           DateTime
  sourceWindowKey        String?
  engagementScore        Decimal? @db.Decimal(5, 2)
  consistencyScore       Decimal? @db.Decimal(5, 2)
  streakScore            Decimal? @db.Decimal(5, 2)
  participationScore     Decimal? @db.Decimal(5, 2)
  completionScore        Decimal? @db.Decimal(5, 2)
  inactivityRiskScore    Decimal? @db.Decimal(5, 2)
  momentumScore          Decimal? @db.Decimal(5, 2)
